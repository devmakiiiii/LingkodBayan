# Copy this file to .env.local and fill in the values for your environment.
# Never commit real credentials. See README.md > Environment Variables.

# Supabase project URL (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anonymous/public key (safe for the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key (SERVER ONLY - never expose to the client)
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string used by the Supabase stack
POSTGRES_URL=

# Public origin of the app, used for auth redirects and origin checks
# e.g. https://your-domain.com in production
NEXT_PUBLIC_APP_URL=http://localhost:3000
